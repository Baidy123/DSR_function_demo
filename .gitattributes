# 默认：所有文本文件统一 UTF-8 + LF（由 Git 自动识别文本）
* text=auto eol=lf

# 源码相关文件配置
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.s     text eol=lf
*.ld    text eol=lf

# 参与构建的文本与着色器
*.rc    text eol=lf
*.hlsl  text eol=lf
*.txt   text eol=lf
*.dat   text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf

# JSON 文件配置
*.json text eol=lf

# Markdown 文件配置
*.md text eol=lf

# 二进制资产（不做换行转换）
*.png   binary
*.bmp   binary
*.bin   binary
*.ico   binary
*.docx  binary

# 仓库配置相关文件配置
.gitignore      text eol=lf
.gitattributes  text eol=lf
*.exe           binary

# 编译规则相关
*.mk     text eol=lf
Makefile text eol=lf

# Windows 批处理文件需要以 CRLF 结尾
*.bat text eol=crlf