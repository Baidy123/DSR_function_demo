; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="角色移动练习"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
DialogueManager="*uid://c3rodes2l3gxb"
GameState="*res://scripts/systems/game_state.gd"
DebugSettings="*res://scripts/debug/debug_settings.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="logs/game.log"

[display]

window/size/viewport_width=1120
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/enemy_training_inspector/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/weapon_mode_inspector/plugin.cfg")

[gui]

theme/custom_font="res://resources/fonts/NotoSansSC-Medium.ttf"

