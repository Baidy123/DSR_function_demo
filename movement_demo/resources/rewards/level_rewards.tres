[gd_resource type="Resource" script_class="RewardTable" load_steps=25 format=3]

[ext_resource type="Script" path="res://scripts/rewards/reward_table.gd" id="1_table"]
[ext_resource type="Script" path="res://scripts/rewards/reward_level.gd" id="2_level"]
[ext_resource type="Script" path="res://scripts/rewards/reward_option.gd" id="3_option"]

[sub_resource type="Resource" id="L1_Heal"]
script = ExtResource("3_option")
id = &"first_aid"
display_name = "急救包"
description = "恢复 35 点生命"
effect = 0
amount = 35

[sub_resource type="Resource" id="L1_Ammo"]
script = ExtResource("3_option")
id = &"ammo"
display_name = "弹药补给"
description = "补满弹匣与备弹"
effect = 1

[sub_resource type="Resource" id="L1_Progress"]
script = ExtResource("3_option")
id = &"system_progress"
display_name = "系统进度"
description = "任务进度 +20"
effect = 2
amount = 20

[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_level")
level = 1
options = Array[ExtResource("3_option")]([SubResource("L1_Heal"), SubResource("L1_Ammo"), SubResource("L1_Progress")])

