[resource]
script = ExtResource("profile")
unit_id = &"ranged"
display_name = "远程兵"
capabilities = Array[StringName]([&"locomotion", &"firearms"])
default_behaviors = Array[ExtResource("definition")]([ExtResource("patrol"), ExtResource("search"), ExtResource("engage"), ExtResource("reload")])
tactical_actions = Array[ExtResource("definition")]([ExtResource("cover"), ExtResource("covering_retreat"), ExtResource("attack_position"), ExtResource("suppression"), ExtResource("cooperate")])
