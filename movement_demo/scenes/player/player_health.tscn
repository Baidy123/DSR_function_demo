[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/player_health.gd" id="1"]
[ext_resource type="Script" path="res://scripts/debug/noise_debug.gd" id="2_noise"]
[ext_resource type="Script" path="res://scripts/player/player_medkit.gd" id="3_medkit"]
[ext_resource type="Script" path="res://scripts/ui/medkit_indicator.gd" id="4_medkit_indicator"]
[ext_resource type="Resource" path="res://resources/player/default_medkit.tres" id="5_medkit_settings"]

[sub_resource type="StyleBoxFlat" id="StatusPanel"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.04, 0.06, 0.08, 0.88)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="BarBackground"]
bg_color = Color(0.12, 0.15, 0.17, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3

[sub_resource type="StyleBoxFlat" id="HealthFill"]
bg_color = Color(0.85, 0.3, 0.35, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3

[sub_resource type="StyleBoxFlat" id="StaminaFill"]
bg_color = Color(0.25, 0.8, 0.65, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3

[node name="Health" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1")

[node name="Medkit" type="Node" parent="."]
script = ExtResource("3_medkit")
settings = ExtResource("5_medkit_settings")

[node name="MedkitIndicator" type="Control" parent="."]
visible = false
mouse_filter = 2
script = ExtResource("4_medkit_indicator")

[node name="NoiseRanges" type="Node3D" parent="."]
script = ExtResource("2_noise")

[node name="Status" type="PanelContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -170.0
offset_right = 316.0
offset_bottom = -16.0
grow_vertical = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StatusPanel")

[node name="Content" type="VBoxContainer" parent="Status"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="HealthLabel" type="Label" parent="Status/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "生命 100 / 100"

[node name="HealthBar" type="ProgressBar" parent="Status/Content"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("BarBackground")
theme_override_styles/fill = SubResource("HealthFill")
step = 0.1
value = 100.0
show_percentage = false

[node name="Stamina" type="VBoxContainer" parent="Status/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Status/Content/Stamina"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "体力 100 / 100"

[node name="Bar" type="ProgressBar" parent="Status/Content/Stamina"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("BarBackground")
theme_override_styles/fill = SubResource("StaminaFill")
step = 0.1
value = 100.0
show_percentage = false

[node name="Debug" type="PanelContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -430.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = 67.0
grow_horizontal = 0
mouse_filter = 2
theme_override_styles/panel = SubResource("StatusPanel")

[node name="Controls" type="HBoxContainer" parent="Debug"]
layout_mode = 2
mouse_filter = 2
alignment = 1

[node name="Invincible" type="CheckBox" parent="Debug/Controls"]
layout_mode = 2
focus_mode = 0
tooltip_text = "统一开启调试视图与玩家无敌；关闭后恢复正常受伤，不回血或复活。"
text = "Debug 总开关"

[node name="Damage" type="Button" parent="Debug/Controls"]
layout_mode = 2
focus_mode = 0
tooltip_text = "模拟受到 25 点伤害，用于测试生命、无敌与死亡重开。"
text = "测试受伤 -25"

[node name="NoiseRanges" type="CheckBox" parent="Debug/Controls"]
layout_mode = 2
focus_mode = 0
button_pressed = true
tooltip_text = "实际发声时短暂显示：玩家蓝色、敌人橙色。外圈为无遮挡半径，内虚线圈为隔墙半径；不代表按墙裁切的精确形状。"
text = "声音范围"

[node name="DeathScreen" type="ColorRect" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.05, 0.8)

[node name="Center" type="CenterContainer" parent="DeathScreen"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="DeathScreen/Center"]
custom_minimum_size = Vector2(440, 180)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="DeathScreen/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="DeathScreen/Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "你已死亡"
horizontal_alignment = 1

[node name="Message" type="Label" parent="DeathScreen/Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "回到出生点，重置战斗；保留对话选择。"
horizontal_alignment = 1

[node name="Restart" type="Button" parent="DeathScreen/Center/Panel/Content"]
