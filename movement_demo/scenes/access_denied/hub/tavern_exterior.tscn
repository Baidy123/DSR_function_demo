[sub_resource type="Resource" id="SceneEventTrigger_arrival_requested"]
script = ExtResource("scene_event_trigger")
source_path = NodePath("../Opening")
signal_name = &"arrival_event_requested"

[sub_resource type="Resource" id="SceneAction_arrival_dialogue"]
script = ExtResource("dialogue_action")
target_path = NodePath("../DialogueUI")
player_path = NodePath("../Player")
source_path = NodePath("../Car")
dialogue = ExtResource("opening_dialogue")
start = "arrival"

[sub_resource type="Resource" id="SceneAction_exit_car"]
script = ExtResource("run_provider_action")
target_path = NodePath("../Opening")
parameters = {
"opening_command": &"exit_car"
}

[sub_resource type="Resource" id="SceneAction_focus_entrance"]
script = ExtResource("camera_action")
target_path = NodePath("../Entrance")
move_seconds = 0.55
hold_seconds = 0.3
return_seconds = 0.45
camera_size = 11.0

[sub_resource type="Resource" id="SceneAction_finish_arrival"]
script = ExtResource("run_provider_action")
target_path = NodePath("../Opening")
parameters = {
"opening_command": &"finish_arrival"
}

[sub_resource type="Resource" id="SceneEvent_opening_arrival"]
script = ExtResource("scene_event_definition")
event_id = &"opening_arrival"
label = "车内独白、下车并聚焦酒吧入口"
triggers = Array[ExtResource("scene_event_trigger")]([SubResource("SceneEventTrigger_arrival_requested")])
actions = Array[ExtResource("scene_action_base")]([SubResource("SceneAction_arrival_dialogue"), SubResource("SceneAction_exit_car"), SubResource("SceneAction_focus_entrance"), SubResource("SceneAction_finish_arrival")])

[sub_resource type="Resource" id="SceneEventTrigger_transition_requested"]
script = ExtResource("scene_event_trigger")
source_path = NodePath("../Opening")
signal_name = &"scene_transition_requested"

[sub_resource type="Resource" id="SceneAction_mark_opening_active"]
script = ExtResource("set_flag_action")
state_path = NodePath("/root/GameState")
flag = &"opening_active"

[sub_resource type="Resource" id="SceneAction_enter_tavern"]
script = ExtResource("change_scene_action")
scene_path = "res://scenes/main.tscn"
return_control_on_failure = true

[sub_resource type="Resource" id="SceneEvent_opening_scene_transition"]
script = ExtResource("scene_event_definition")
event_id = &"opening_scene_transition"
label = "进入酒吧并保留转场失败后的控制权"
triggers = Array[ExtResource("scene_event_trigger")]([SubResource("SceneEventTrigger_transition_requested")])
actions = Array[ExtResource("scene_action_base")]([SubResource("SceneAction_mark_opening_active"), SubResource("SceneAction_enter_tavern")])

